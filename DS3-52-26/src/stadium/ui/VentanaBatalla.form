<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="stadium.ui.VentanaBatalla">
  <grid id="b2e00" binding="mainPanel" custom-create="true" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="15" vgap="10">
    <margin top="80" left="15" bottom="15" right="15"/>
    <constraints>
      <xy x="20" y="20" width="760" height="800"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <nested-form id="b2e01" form-file="stadium/ui/PanelPokemon.form" binding="panel1">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <nested-form id="b2e02" form-file="stadium/ui/PanelPokemon.form" binding="panel2">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <component id="b2e03" class="javax.swing.JButton" binding="botonFight">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="false"/>
          <font name="SansSerif" size="22" style="1"/>
          <text value="Fight!"/>
        </properties>
      </component>
      <scrollpane id="b2e04" binding="scrollLog">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b2e05" class="javax.swing.JTextArea" binding="areaLog">
            <constraints/>
            <properties>
              <background color="-14800826"/>
              <editable value="false"/>
              <font name="Monospaced" size="13" style="1"/>
              <foreground color="-1"/>
              <margin top="8" left="10" bottom="8" right="10"/>
              <rows value="12"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
